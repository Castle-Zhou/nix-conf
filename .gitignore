# macOS
.DS_Store

# 机器本地配置：每个使用者自己生成，git add -f 后 flake 才可见（见 README「快速开始」）
machine.nix
machine-home.nix   # 机器级 home 补丁（machine.nix 里 imports 它，可选）
hardware-configuration.nix

# nix 构建产物
result
result-*

# 编辑器/开发工具
*.swp
*~
.direnv/

# 壁纸（仓库默认壁纸已入库；个人壁纸放 ~/slot/wallpaper.jpg）
wallpaper.jpg

# Clash: binary, geoip db, cache and subscription config (contains secrets)
clash/

# Rime build artifacts
rime/build/
rime/*.userdb/
rime/*.userdb.txt
# Rime 运行时状态（每台机器自己生成，不入库）
rime/user.yaml
rime/installation.yaml
